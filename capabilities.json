{
    "dataRoles": [
        {
            "displayName": "City",
            "name": "location",
            "kind": "Grouping",
            "description": "City of each row (optionally a second level below it: postal code, or customer/store with Latitude/Longitude). The map aggregates the cities into countries, districts and municipalities.",
            "displayNameKey": "Role_Location",
            "descriptionKey": "Role_Location_Desc"
        },
        {
            "displayName": "Country",
            "name": "countryGroup",
            "kind": "Grouping",
            "description": "Country column of the same table (e.g. Dim[Country], name or ISO2/ISO3). Each city is read inside its own country, so cities with the same name in different countries stay separate.",
            "displayNameKey": "Role_CountryGroup",
            "descriptionKey": "Role_CountryGroup_Desc"
        },
        {
            "displayName": "Detail (legend)",
            "name": "legend",
            "kind": "Grouping",
            "description": "Optional. Splits each bubble/area into a donut with one slice per category.",
            "displayNameKey": "Role_Legend",
            "descriptionKey": "Role_Legend_Desc"
        },
        {
            "displayName": "Value (color)",
            "name": "color",
            "kind": "Measure",
            "description": "Measure that drives the color scale of areas and bubbles.",
            "displayNameKey": "Role_Color",
            "descriptionKey": "Role_Color_Desc"
        },
        {
            "displayName": "Size",
            "name": "size",
            "kind": "Measure",
            "description": "Measure that drives bubble size. When empty, Value (color) is used.",
            "displayNameKey": "Role_Size",
            "descriptionKey": "Role_Size_Desc"
        },
        {
            "displayName": "Postal code (optional)",
            "name": "postalCode",
            "kind": "Measure",
            "description": "Measure returning the postal code, used to place cities whose name is not found and the level below the city. Alternatively put the postal code column as the last Location level.",
            "displayNameKey": "Role_PostalCode",
            "descriptionKey": "Role_PostalCode_Desc"
        },
        {
            "displayName": "Latitude (lowest level)",
            "name": "latitude",
            "kind": "Measure",
            "description": "Explicit measure (e.g. AVERAGE/SELECTEDVALUE). Used for the level below the city (customer, store, postal code) and as a fallback when a city is not found.",
            "displayNameKey": "Role_Latitude",
            "descriptionKey": "Role_LatLon_Desc"
        },
        {
            "displayName": "Longitude (lowest level)",
            "name": "longitude",
            "kind": "Measure",
            "description": "Explicit measure (e.g. AVERAGE/SELECTEDVALUE). Used for the level below the city (customer, store, postal code) and as a fallback when a city is not found.",
            "displayNameKey": "Role_Longitude",
            "descriptionKey": "Role_LatLon_Desc"
        },
        {
            "displayName": "Tooltips",
            "name": "tooltips",
            "kind": "Measure",
            "displayNameKey": "Role_Tooltips"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "location": {
                        "max": 2
                    },
                    "legend": {
                        "max": 1
                    },
                    "color": {
                        "max": 1
                    },
                    "size": {
                        "max": 1
                    },
                    "latitude": {
                        "max": 1
                    },
                    "longitude": {
                        "max": 1
                    },
                    "postalCode": {
                        "max": 1
                    },
                    "countryGroup": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        {
                            "for": {
                                "in": "countryGroup"
                            }
                        },
                        {
                            "for": {
                                "in": "location"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 30000
                        }
                    }
                },
                "values": {
                    "group": {
                        "by": "legend",
                        "select": [
                            {
                                "for": {
                                    "in": "color"
                                }
                            },
                            {
                                "for": {
                                    "in": "size"
                                }
                            },
                            {
                                "for": {
                                    "in": "postalCode"
                                }
                            },
                            {
                                "for": {
                                    "in": "latitude"
                                }
                            },
                            {
                                "for": {
                                    "in": "longitude"
                                }
                            },
                            {
                                "for": {
                                    "in": "tooltips"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 60
                            }
                        }
                    }
                }
            }
        }
    ],
    "drilldown": {
        "roles": [
            "location"
        ]
    },
