    "d3-polygon": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "powerbi-models": "^2.2.0",
    "powerbi-visuals-api": "5.11.1",
    "powerbi-visuals-utils-dataviewutils": "^7.0.0",
    "powerbi-visuals-utils-formattingmodel": "^6.0.4",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.11.1",
    "eslint-plugin-powerbi-visuals": "^1.0.0",
    "powerbi-visuals-tools": "^7.2.1",
